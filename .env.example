# Copy to .env and replace the token. Never commit .env.
AUDYSSEY_TOOL_TOKEN=replace-with-a-random-token
AUDYSSEY_SAM_AUDIO_MODEL=mrfakename/sam-audio-large-tv
AUDYSSEY_SAM_AUDIO_JUDGE_MODEL=mrfakename/sam-audio-judge
HF_CACHE=/home/common/huggingface
# GPU index per tool server (same index = share one GPU).
AUDYSSEY_SEPARATION_GPU=0
AUDYSSEY_JUDGE_GPU=0
# Laptop + RunPod: both tools share one Pod endpoint.
# AUDYSSEY_SEPARATOR_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_FILTER_URL=https://your-pod-8700.proxy.runpod.net
