# Copy to .env and replace the token. Never commit .env.
AUDYSSEY_TOOL_TOKEN=replace-with-a-random-token
# Official gated models: request access on Hugging Face, then download into HF_CACHE (README 2.7).
AUDYSSEY_SAM_AUDIO_MODEL=facebook/sam-audio-large-tv
AUDYSSEY_SAM3_MODEL=facebook/sam3.1
AUDYSSEY_SAM_AUDIO_JUDGE_MODEL=facebook/sam-audio-judge
HF_CACHE=/home/common/huggingface
# GPU index per tool server (same index = share one GPU).
AUDYSSEY_SEPARATION_GPU=0
AUDYSSEY_JUDGE_GPU=0
AUDYSSEY_GROUNDING_GPU=0
# Laptop + RunPod: all three tools share one Pod endpoint.
# AUDYSSEY_SEPARATOR_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_FILTER_URL=https://your-pod-8700.proxy.runpod.net
# AUDYSSEY_GROUNDING_URL=https://your-pod-8700.proxy.runpod.net

# Local vLLM planner (cache must already contain this model and its processor).
AUDYSSEY_VLLM_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
AUDYSSEY_VLLM_GPU=0
# Fraction of the vLLM GPU's memory. 0.2 leaves room for the three tools on one 80GB GPU;
# raise it (e.g. 0.85) when vLLM has a GPU of its own.
AUDYSSEY_VLLM_GPU_UTIL=0.2
# Gemini: set these two lines instead of the default local vLLM endpoint.
# AUDYSSEY_PLANNER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AUDYSSEY_PLANNER_MODEL=gemini-2.5-flash
# Inject GOOGLE_API_KEY privately; Compose forwards it as AUDYSSEY_PLANNER_API_KEY.
